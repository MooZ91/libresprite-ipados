--- a/src/video/uikit/SDL_uikitappdelegate.m	2026-10-11 12:50:57
+++ b/src/video/uikit/SDL_uikitappdelegate.m	2026-10-11 12:51:52
@@ -349,6 +349,38 @@
 
 @end
 
+/* iOS 27 aborts apps built against its SDK that do not adopt the UIScene
+   lifecycle. The scene is only a vehicle here: SDL keeps drawing into the
+   windows it creates itself, but they have to be attached to a UIWindowScene,
+   so remember the one UIKit connects. Info.plist names this class as the
+   scene delegate. */
+UIWindowScene *SDL_UIKitWindowScene = nil;
+
+@interface SDLUIKitSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@property (nonatomic, strong) UIWindow *window;
+@end
+
+@implementation SDLUIKitSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        SDL_UIKitWindowScene = (UIWindowScene *)scene;
+    }
+    /* Scene-based apps get documents here instead of application:openURL: */
+    [self scene:scene openURLContexts:connectionOptions.URLContexts];
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+    id<UIApplicationDelegate> delegate = [UIApplication sharedApplication].delegate;
+    for (UIOpenURLContext *context in URLContexts) {
+        [delegate application:[UIApplication sharedApplication] openURL:context.URL options:@{}];
+    }
+}
+
+@end
+
 @implementation SDLUIKitDelegate {
     UIWindow *launchWindow;
 }
